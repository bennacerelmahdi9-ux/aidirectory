# Database
DATABASE_URL="postgresql://aiatlas:aiatlas@localhost:5432/aiatlas?schema=public"

# Auth (NextAuth/Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI generation (OpenRouter) — submit form "Generate using AI"
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Stripe paid submissions (sandbox = test keys, live = live keys)
SUBMISSION_PAYMENT_ENABLED="false"
STRIPE_MODE="test"
STRIPE_SECRET_KEY_TEST="sk_test_..."
STRIPE_SECRET_KEY_LIVE="sk_live_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_..."
STRIPE_WEBHOOK_SECRET_LIVE="whsec_..."
STRIPE_SUBMISSION_PRICE_CENTS="900"