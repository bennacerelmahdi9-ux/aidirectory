generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  CONTACT
  OPEN_SOURCE
}

enum ToolStatus {
  PENDING_PAYMENT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ResourceType {
  API
  SDK
  REPOSITORY
  DATASET
  DOCUMENTATION
  TUTORIAL
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tools         Tool[]    @relation("SubmittedTools")
  reviews       Review[]
  bookmarks     Bookmark[]
  reports       Report[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools Tool[]
}

model Tool {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  logo           String?
  description    String
  longDescription String?
  websiteUrl     String
  categoryId     String
  pricingModel   PricingModel @default(FREEMIUM)
  hasFreePlan    Boolean      @default(false)
  isOpenSource   Boolean      @default(false)
  platforms      String[]     @default([])
  tags           String[]     @default([])
  screenshots    String[]     @default([])
  lastVerifiedAt DateTime?
  status         ToolStatus   @default(PENDING)
  featured       Boolean      @default(false)
  viewCount      Int          @default(0)
  paidAt         DateTime?
  stripeSessionId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  submittedBy User?   @relation("SubmittedTools", fields: [submittedById], references: [id])
  submittedById String?
  verifiedById  String?

  reviews    Review[]
  bookmarks  Bookmark[]
  reports    Report[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([toolId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model Report {
  id        String       @id @default(cuid())
  reason    String
  details   String?
  status    ReportStatus @default(OPEN)
  toolId    String
  userId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tool Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AIModel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  provider       String
  description    String
  capabilities   String[] @default([])
  contextLength  Int?
  license        String?
  isOpenSource   Boolean  @default(false)
  apiAvailable   Boolean  @default(false)
  docsUrl        String?
  websiteUrl     String?
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([provider])
}

model DeveloperResource {
  id          String       @id @default(cuid())
  title       String
  type        ResourceType @default(OTHER)
  url         String
  description String
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
